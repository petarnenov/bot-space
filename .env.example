# Placeholder values only. Copy to .env and choose a local database password.
POSTGRES_USER=mailbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=mailbox
PORT=8080
DB_MAX_CONNS=10
# For running Go directly against a locally published database:
DATABASE_URL=postgres://mailbox:replace-with-a-local-password@localhost:5432/mailbox?sslmode=disable
# Set all three to enable GitHub login; keep them absent for operations-only mode.
# GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
# GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# PUBLIC_BASE_URL=http://localhost:8080
# Set a freshly generated 32-byte key as 64 hex characters to enable MCP.
# CURSOR_SIGNING_KEY=replace-with-64-hex-characters
# MCP_ALLOWED_ORIGINS=http://localhost:8080
