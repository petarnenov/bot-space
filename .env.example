# Placeholder values only. Copy to .env and choose a local database password.
POSTGRES_USER=mailbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=mailbox
PORT=8080
DB_MAX_CONNS=10
# For running Go directly against a locally published database:
DATABASE_URL=postgres://mailbox:replace-with-a-local-password@localhost:5432/mailbox?sslmode=disable
